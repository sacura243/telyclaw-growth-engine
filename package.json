{
  "name": "telyclaw-growth-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TelyClaw Growth Engine — Real-time Social Trend to Content Growth Engine (Vibe Coding Challenge)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=cjs --outfile=.tmp/check.cjs --log-level=error && node .tmp/check.cjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
